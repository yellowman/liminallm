# Copy to .env and fill in. Used by docker-compose.
#
# Only DATABASE_URL, SHARED_FS_ROOT, EMBEDDING_VECTOR_DIM, the provider API keys and
# INSTANCE_SETTINGS_JSON are read from the environment; compose builds those
# from the values below. Everything else lives in the admin console.

# Required
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me

# Provider credential for whichever backend you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Seeded into the admin settings on first boot only.
MODEL_BACKEND=openai
MODEL_PATH=gpt-4o-mini
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_VECTOR_DIM=1536

# Where the data lives on this machine. Environment-only: it is needed while
# the Postgres store is being constructed, before any database-managed setting
# is readable. Under Compose this is both the app's setting and the volume's
# mount point, so changing it moves both.
SHARED_FS_ROOT=/srv/liminallm
APP_BASE_URL=http://localhost:8000

# Ports
HOST_BIND=127.0.0.1
HOST_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
