# LiminalLM OpenBSD Environment Configuration
# Place in /etc/liminallm/env
# chmod 640 /etc/liminallm/env
# chown root:_liminallm /etc/liminallm/env

# =============================================================================
# REQUIRED - Database (PostgreSQL with pgvector)
# =============================================================================
DATABASE_URL="postgresql://liminallm:password@localhost/liminallm"

# =============================================================================
# REQUIRED - Redis
# =============================================================================
REDIS_URL="redis://localhost:6379/0"

# =============================================================================
# REQUIRED - OpenAI API
# =============================================================================
OPENAI_API_KEY="sk-your-openai-api-key"

# =============================================================================
# Storage
# =============================================================================
SHARED_FS_ROOT="/var/liminallm"

# =============================================================================
# Model Configuration
# =============================================================================
MODEL_BACKEND="openai"
ADAPTER_SERVER_MODEL="gpt-4o"
EMBEDDING_MODEL_ID="text-embedding-3-small"

# Google Gemini via the OpenAI-compatible endpoint: set MODEL_BACKEND="gemini",
# MODEL_PATH to a Gemini model (e.g. "gemini-flash-latest"), and the API key.
#GEMINI_API_KEY="your-gemini-api-key"
#MODEL_PATH="gemini-flash-latest"

# Thinking control for reasoning models (OpenAI o-series, Gemini 2.5/3):
# "low" | "medium" | "high", or "none" to disable where the provider allows.
#MODEL_REASONING_EFFORT="low"

# =============================================================================
# Multiple replicas
# =============================================================================
# Transport used to reach the replica holding a stream when you cancel it.
# "auto" prefers Redis pub/sub and falls back to Postgres LISTEN/NOTIFY, so
# Redis stays optional. Use "local" for a single-process deployment.
# One of: auto | redis | postgres | local
#CLUSTER_BUS_BACKEND="auto"

# =============================================================================
# Web tools (search + browse)
# =============================================================================
# Browsing (web_fetch) is on by default. Fetches always refuse private,
# loopback, link-local, and cloud-metadata addresses, re-checked on every
# redirect; fetched pages are sanitized, scanned for prompt injection, and
# handed to the model as untrusted data it is told never to obey.
WEB_TOOLS_ENABLED="true"

# Search (web_search) stays inert until a provider and key are set.
# One of: none | brave | tavily | google_cse | duckduckgo
WEB_SEARCH_PROVIDER="none"
#WEB_SEARCH_API_KEY="your-search-api-key"
#WEB_SEARCH_ENGINE_ID="google-cse-engine-id"   # google_cse only
#WEB_FETCH_TIMEOUT="15"
#WEB_FETCH_MAX_BYTES="2097152"

# TEST ONLY — disables SSRF protection so local addresses can be fetched.
# Never enable this in production.
#WEB_FETCH_ALLOW_PRIVATE="false"

# =============================================================================
# Authentication
# =============================================================================
# JWT_SECRET will be auto-generated if not set
# JWT_SECRET="your-64-char-secret"
JWT_ISSUER="liminallm"
JWT_AUDIENCE="liminal-clients"
ACCESS_TOKEN_TTL_MINUTES="30"
REFRESH_TOKEN_TTL_MINUTES="1440"
ENABLE_MFA="true"

# =============================================================================
# Email (optional)
# =============================================================================
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@example.com"
# SMTP_PASSWORD="password"
# SMTP_USE_TLS="true"
# EMAIL_FROM_ADDRESS="noreply@example.com"
# EMAIL_FROM_NAME="LiminalLM"
APP_BASE_URL="https://liminallm.example.com"

# =============================================================================
# Rate Limits
# =============================================================================
CHAT_RATE_LIMIT_PER_MINUTE="60"
RESET_RATE_LIMIT_PER_MINUTE="5"
